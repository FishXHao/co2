{
  "openapi": "3.0.0",
  "info": {
    "title": "碳捕捉與封存監測 API",
    "version": "1.0.0",
    "description": "參考台灣中油「碳封存示範場域環境資訊」網站（https://service.cpc.com.tw:8101）功能整理之 API 規格，涵蓋灌注量摘要、自動連續監測（大氣 CO2、土壤氣體、地下水水質、微震）、環境定期監測（生態、交通量、噪音、地下水）、負碳科技知識內容與科普影音。此文件僅涵蓋 API Doc 階段，對應之 SD Doc / DB Schema 尚未建立，實作前應先補齊。",
    "contact": {
      "name": "API Support",
      "email": "support@copilot-lab.dev"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "開發環境"
    },
    {
      "url": "https://api.copilot-lab.dev",
      "description": "生產環境（規劃中）"
    }
  ],
  "tags": [
    { "name": "InjectionVolume", "description": "二氧化碳灌注量摘要與紀錄" },
    { "name": "Stations", "description": "監測站點主檔資訊" },
    { "name": "AtmosphereMonitoring", "description": "大氣即時 CO2 監測" },
    { "name": "SoilGasMonitoring", "description": "土壤氣體即時監測" },
    { "name": "GroundwaterMonitoring", "description": "地下水水質即時監測" },
    { "name": "SeismicMonitoring", "description": "微震監測" },
    { "name": "PeriodicMonitoring", "description": "環境定期監測（生態、交通量、噪音、地下水）" },
    { "name": "KnowledgeContent", "description": "負碳科技與視野知識內容" },
    { "name": "EducationalVideos", "description": "碳封存相關科普影音" }
  ],
  "paths": {
    "/api/carbon-capture/injection-volumes/summary": {
      "get": {
        "tags": ["InjectionVolume"],
        "summary": "取得灌注量摘要",
        "description": "取得本日灌注量、本月灌注量與二氧化碳累積灌注量（含目標值）",
        "operationId": "getInjectionVolumeSummary",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InjectionVolumeSummary" }
              }
            }
          },
          "500": {
            "description": "伺服器錯誤",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/carbon-capture/injection-records": {
      "get": {
        "tags": ["InjectionVolume"],
        "summary": "查詢灌注紀錄",
        "description": "依日期區間查詢每日灌注量歷史紀錄",
        "operationId": "listInjectionRecords",
        "parameters": [
          { "$ref": "#/components/parameters/StartDate" },
          { "$ref": "#/components/parameters/EndDate" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/InjectionRecord" }
                }
              }
            }
          },
          "400": {
            "description": "參數錯誤",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "post": {
        "tags": ["InjectionVolume"],
        "summary": "新增灌注紀錄",
        "description": "新增單日灌注量紀錄（供內部系統或人工建檔使用）",
        "operationId": "createInjectionRecord",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InjectionRecordInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "新增成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InjectionRecord" } } }
          },
          "400": {
            "description": "參數錯誤",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "未認證",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "403": {
            "description": "無權限",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/carbon-capture/stations": {
      "get": {
        "tags": ["Stations"],
        "summary": "取得監測站點列表",
        "description": "取得所有監測站點主檔資料，可依監測類型篩選",
        "operationId": "listStations",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "監測類型篩選",
            "required": false,
            "schema": { "$ref": "#/components/schemas/MonitoringType" }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Station" } }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Stations"],
        "summary": "新增監測站點",
        "operationId": "createStation",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StationInput" } } }
        },
        "responses": {
          "201": {
            "description": "新增成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Station" } } }
          },
          "400": {
            "description": "參數錯誤",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "未認證",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "403": {
            "description": "無權限",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/carbon-capture/stations/{stationId}": {
      "get": {
        "tags": ["Stations"],
        "summary": "取得單一監測站點資訊",
        "operationId": "getStation",
        "parameters": [{ "$ref": "#/components/parameters/StationId" }],
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Station" } } }
          },
          "404": {
            "description": "找不到資源",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "put": {
        "tags": ["Stations"],
        "summary": "更新監測站點資訊",
        "operationId": "updateStation",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/StationId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StationInput" } } }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Station" } } }
          },
          "400": {
            "description": "參數錯誤",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "未認證",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "403": {
            "description": "無權限",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "找不到資源",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "delete": {
        "tags": ["Stations"],
        "summary": "刪除監測站點",
        "operationId": "deleteStation",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/StationId" }],
        "responses": {
          "204": { "description": "刪除成功" },
          "401": {
            "description": "未認證",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "403": {
            "description": "無權限",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "找不到資源",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/carbon-capture/monitoring/atmosphere": {
      "get": {
        "tags": ["AtmosphereMonitoring"],
        "summary": "取得各站點大氣即時 CO2 監測值",
        "description": "取得城中站、梅南里站、坪頂站、封存場站等各站點最新 CO2 濃度（ppm）與狀態",
        "operationId": "listAtmosphereReadings",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/MonitoringReading" } }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["AtmosphereMonitoring"],
        "summary": "上傳大氣 CO2 監測數值",
        "description": "供監測設備／感測器上傳即時讀值使用",
        "operationId": "createAtmosphereReading",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MonitoringReadingInput" } } }
        },
        "responses": {
          "201": {
            "description": "新增成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MonitoringReading" } } }
          },
          "400": {
            "description": "參數錯誤",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "未認證",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/carbon-capture/monitoring/atmosphere/{stationId}/history": {
      "get": {
        "tags": ["AtmosphereMonitoring"],
        "summary": "查詢單一站點大氣 CO2 歷史監測資料",
        "operationId": "getAtmosphereHistory",
        "parameters": [
          { "$ref": "#/components/parameters/StationId" },
          { "$ref": "#/components/parameters/StartDate" },
          { "$ref": "#/components/parameters/EndDate" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/MonitoringReading" } }
              }
            }
          },
          "404": {
            "description": "找不到資源",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
