    "/api/carbon-capture/videos": {
      "get": {
        "tags": ["EducationalVideos"],
        "summary": "取得碳封存相關科普影音列表",
        "description": "取得碳來源、碳捕捉、碳再利用、碳運輸、碳封存（陸域／濱海／海域封存）等影片列表",
