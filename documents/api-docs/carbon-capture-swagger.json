      }
    },
    "/api/carbon-capture/periodic-monitorings": {
      "get": {
        "tags": ["PeriodicMonitoring"],
        "summary": "取得環境定期監測分類列表",
        "description": "取得生態監測、交通量監測、環境噪音監測、地下水監測等定期監測分類與最新報告摘要",
