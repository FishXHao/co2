      "get": {
        "tags": ["SeismicMonitoring"],
        "summary": "取得微震即時監測資料",
        "description": "取得封存場站微震監測事件與狀態",
        "operationId": "listSeismicReadings",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/MonitoringReading" } }
              }
