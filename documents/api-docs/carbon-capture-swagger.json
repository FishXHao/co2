          }
        }
      },
      "post": {
        "tags": ["SeismicMonitoring"],
        "summary": "上傳微震監測事件",
        "operationId": "createSeismicReading",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MonitoringReadingInput" } } }
        },
        "responses": {
          "201": {
            "description": "新增成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MonitoringReading" } } }
          },
          "400": {
            "description": "參數錯誤",
