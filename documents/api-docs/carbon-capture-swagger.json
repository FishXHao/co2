            "description": "未認證",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/carbon-capture/monitoring/groundwater-quality/{stationId}/history": {
      "get": {
        "tags": ["GroundwaterMonitoring"],
        "summary": "查詢單一站點地下水水質歷史監測資料",
