        "tags": ["SoilGasMonitoring"],
        "summary": "上傳土壤氣體監測數值",
        "operationId": "createSoilGasReading",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MonitoringReadingInput" } } }
        },
        "responses": {
          "201": {
            "description": "新增成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MonitoringReading" } } }
          },
          "400": {
            "description": "參數錯誤",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "未認證",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/carbon-capture/monitoring/soil-gas/{stationId}/history": {
      "get": {
        "tags": ["SoilGasMonitoring"],
        "summary": "查詢單一站點土壤氣體歷史監測資料",
        "operationId": "getSoilGasHistory",
        "parameters": [
          { "$ref": "#/components/parameters/StationId" },
