            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/EducationalVideo" } }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["EducationalVideos"],
        "summary": "新增科普影音",
        "operationId": "createEducationalVideo",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EducationalVideoInput" } } }
        },
        "responses": {
          "201": {
            "description": "新增成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EducationalVideo" } } }
          },
          "400": {
            "description": "參數錯誤",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "未認證",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "403": {
            "description": "無權限",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/carbon-capture/videos/{videoId}": {
      "get": {
        "tags": ["EducationalVideos"],
        "summary": "取得單一科普影音資訊",
        "operationId": "getEducationalVideo",
        "parameters": [
          { "name": "videoId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EducationalVideo" } } }
          },
          "404": {
            "description": "找不到資源",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "StationId": {
        "name": "stationId",
        "in": "path",
        "required": true,
        "description": "監測站點代碼",
        "schema": { "type": "string" }
      },
      "StartDate": {
        "name": "startDate",
        "in": "query",
        "required": false,
        "description": "查詢起始日期（YYYY-MM-DD）",
        "schema": { "type": "string", "format": "date" }
      },
      "EndDate": {
        "name": "endDate",
        "in": "query",
        "required": false,
        "description": "查詢結束日期（YYYY-MM-DD）",
        "schema": { "type": "string", "format": "date" }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "description": "錯誤訊息" },
          "code": { "type": "string", "description": "錯誤代碼" }
        }
      },
      "MonitoringType": {
        "type": "string",
        "description": "監測類型",
        "enum": ["atmosphere", "soil_gas", "groundwater_quality", "seismic"]
      },
      "MonitoringStatus": {
        "type": "string",
        "description": "監測狀態：正常／警示／儀器維護檢修中",
        "enum": ["normal", "warning", "maintenance"]
      },
      "Station": {
        "type": "object",
        "properties": {
          "stationId": { "type": "string", "description": "站點代碼" },
          "name": { "type": "string", "description": "站點名稱，例如：城中站、梅南里站、坪頂站、封存場站" },
          "type": { "$ref": "#/components/schemas/MonitoringType" },
          "location": {
            "type": "object",
            "properties": {
              "latitude": { "type": "number", "format": "double" },
              "longitude": { "type": "number", "format": "double" }
            }
          }
        }
      },
      "StationInput": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "$ref": "#/components/schemas/MonitoringType" },
          "location": {
            "type": "object",
            "properties": {
              "latitude": { "type": "number", "format": "double" },
              "longitude": { "type": "number", "format": "double" }
            }
          }
        }
      },
      "MonitoringReading": {
        "type": "object",
        "properties": {
          "stationId": { "type": "string", "description": "站點代碼" },
          "stationName": { "type": "string", "description": "站點名稱" },
          "value": { "type": "number", "format": "double", "description": "監測數值，例如 CO2 濃度、酸鹼值" },
          "unit": { "type": "string", "description": "單位，例如 ppm、%、pH" },
          "baseline": { "type": "number", "format": "double", "description": "基準值／正常範圍下限參考值" },
          "thresholdMax": { "type": "number", "format": "double", "description": "正常範圍上限（如地下水酸鹼值上限）" },
          "status": { "$ref": "#/components/schemas/MonitoringStatus" },
          "recordedAt": { "type": "string", "format": "date-time", "description": "資料時間" }
        }
      },
      "MonitoringReadingInput": {
        "type": "object",
        "required": ["stationId", "value", "unit", "recordedAt"],
        "properties": {
          "stationId": { "type": "string" },
          "value": { "type": "number", "format": "double" },
          "unit": { "type": "string" },
          "recordedAt": { "type": "string", "format": "date-time" }
        }
      },
      "InjectionVolumeSummary": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date", "description": "資料日期" },
          "dailyVolumeTons": { "type": "number", "format": "double", "description": "本日灌注量（噸）" },
          "monthlyVolumeTons": { "type": "number", "format": "double", "description": "本月灌注量（噸）" },
          "cumulativeVolumeTons": { "type": "number", "format": "double", "description": "二氧化碳累積灌注量（噸）" },
          "targetVolumeTons": { "type": "number", "format": "double", "description": "累積灌注目標量（噸），例如 300,000 噸" }
        }
      },
      "InjectionRecord": {
        "type": "object",
        "properties": {
          "recordId": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "volumeTons": { "type": "number", "format": "double", "description": "當日灌注量（噸）" }
        }
      },
      "InjectionRecordInput": {
        "type": "object",
        "required": ["date", "volumeTons"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "volumeTons": { "type": "number", "format": "double" }
        }
      },
      "PeriodicMonitoringCategory": {
        "type": "string",
        "description": "環境定期監測分類",
        "enum": ["ecology", "traffic", "noise", "groundwater"]
      },
      "PeriodicMonitoringReport": {
        "type": "object",
        "properties": {
          "reportId": { "type": "string" },
          "category": { "$ref": "#/components/schemas/PeriodicMonitoringCategory" },
          "title": { "type": "string", "description": "報告標題，例如：生態監測、交通量監測、環境噪音監測、地下水監測" },
          "summary": { "type": "string", "description": "報告摘要內容" },
          "reportDate": { "type": "string", "format": "date" },
          "attachmentUrl": { "type": "string", "format": "uri", "description": "報告附件連結" }
        }
      },
      "KnowledgeCategory": {
        "type": "string",
        "description": "負碳科技與視野文章分類",
        "enum": ["environmental_measure", "storage_encyclopedia", "international_case"]
      },
      "KnowledgeArticle": {
        "type": "object",
        "properties": {
          "articleId": { "type": "string" },
          "category": { "$ref": "#/components/schemas/KnowledgeCategory" },
          "title": { "type": "string", "description": "文章標題，例如：環保對策、碳封存小百科、國際案例" },
          "content": { "type": "string", "description": "文章內容（HTML 或純文字）" },
          "publishedAt": { "type": "string", "format": "date-time" }
        }
      },
      "KnowledgeArticleInput": {
        "type": "object",
        "required": ["category", "title", "content"],
        "properties": {
          "category": { "$ref": "#/components/schemas/KnowledgeCategory" },
          "title": { "type": "string" },
          "content": { "type": "string" }
        }
      },
      "EducationalVideo": {
        "type": "object",
        "properties": {
          "videoId": { "type": "string" },
          "title": { "type": "string", "description": "影片標題，例如：碳來源、碳捕捉、碳再利用、碳運輸、碳封存（陸域／濱海／海域封存）" },
          "thumbnailUrl": { "type": "string", "format": "uri", "description": "影片縮圖網址" },
          "videoUrl": { "type": "string", "format": "uri", "description": "影片播放網址（含外部平台，如 YouTube）" }
        }
      },
      "EducationalVideoInput": {
        "type": "object",
        "required": ["title", "videoUrl"],
        "properties": {
          "title": { "type": "string" },
          "thumbnailUrl": { "type": "string", "format": "uri" },
          "videoUrl": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
